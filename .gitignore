# Git ignore rules for CUNY-Connect.
# This file keeps dependencies, build output, and secrets out of git.
# Owner: Person 1

# Dependencies are rebuilt from package.json, so they never belong in the repo.
node_modules/

# Build output is regenerated by npm run build.
dist/

# Env files hold secrets, so only the .env.example templates are committed.
.env
.env.*
!.env.example

# These are machine-specific files that nobody else needs.
.DS_Store
npm-debug.log*
