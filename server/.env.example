# Template for server/.env in CUNY-Connect.
# Copy it with cp .env.example .env and fill in the real values. Never commit server/.env.
# Owner: Person 1
# TODO: Get the real MONGO_URI from the team privately, not in issues, PRs, or group chats,
# and replace JWT_SECRET with a long random string.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cuny-connect
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
CLIENT_URL=http://localhost:5173
